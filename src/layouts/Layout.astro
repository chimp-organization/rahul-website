---
import '@/styles/starwind.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';
import Metadata from './Metadata.astro';
import { ThemeInitScript } from '@starwind-ui/astro/theme';
import '@/styles/starwind.css';

import type { Metadata as MetadataType } from '../types/metadata';

interface Props extends MetadataType {}

const { ...metadataProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInitScript />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Metadata {...metadataProps} />
    <title>{metadataProps.title}</title>
  </head>
  <body class="touch-action-manipulation">
    <div class="h-full flex flex-col py-2 px-2">
      <Navbar />
      <div class="grow">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
