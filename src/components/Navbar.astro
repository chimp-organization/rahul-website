---
import { ThemeToggle } from '@/components/starwind/theme-toggle';
import Heart from '@tabler/icons/outline/heart.svg';
import Star from '@tabler/icons/outline/star.svg';
import { Button } from '@/components/starwind/button';
import {
  Collapsible,
  CollapsibleContent,
  CollapsibleTrigger,
} from '@/components/starwind/collapsible';
import IconMenu from '@tabler/icons/outline/menu.svg';
---

<!-- Desktop screen navbar -->
<nav
  class="hidden sm:flex items-center justify-between gap-4 px-4 py-3 border-b border-neutral-200 dark:border-neutral-800"
>
  <div class="flex items-center gap-6">
    <h1 class="text-xl font-extrabold tracking-tight">Navbar</h1>
    <div class="flex items-center gap-4">
      <a
        href="/about"
        class="text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors duration-300 ease-out"
        >About</a
      >
      <a
        href="/test"
        class="text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors duration-300 ease-out"
        >Test</a
      >
    </div>
  </div>
  <div class="flex items-center gap-2">
    <ThemeToggle ariaLabel="Toggle theme" />
  </div>
</nav>

<!-- Mobile screen navbar -->
<nav
  class="block sm:hidden px-4 py-3 border-b border-neutral-200 dark:border-neutral-800 touch-action-manipulation"
>
  <Collapsible class="w-full group">
    <div class="flex items-center justify-between w-full">
      <h1 class="text-xl font-extrabold tracking-tight">Navbar</h1>

      <div class="flex items-center gap-2">
        <ThemeToggle size="sm" ariaLabel="Toggle theme with custom icons">
          <Heart
            slot="light-icon"
            class="hidden size-5 group-data-[state=off]:data-ready:block transition-transform duration-300 active:scale-95"
            data-theme-icon
          />
          <Star
            slot="dark-icon"
            class="hidden size-5 group-data-[state=on]:data-ready:block transition-transform duration-300 active:scale-95"
            data-theme-icon
          />
        </ThemeToggle>
        <CollapsibleTrigger asChild>
          <Button
            variant="ghost"
            size="icon-sm"
            class="p-2 transition-transform duration-200 active:scale-95"
          >
            <IconMenu class="size-5" />
            <span class="sr-only">Toggle navigation menu</span>
          </Button>
        </CollapsibleTrigger>
      </div>
    </div>

    <!-- Smooth Height Expanding Container via CSS Grid -->
    <CollapsibleContent
      class="grid grid-rows-[0fr] data-[state=open]:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out w-full overflow-hidden"
    >
      <div class="min-h-0 w-full pt-3 flex flex-col gap-1">
        <a
          class="block w-full rounded-md px-3 py-2 text-base font-medium bg-neutral-100 hover:bg-neutral-200 text-neutral-900 dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-neutral-100 transition-all duration-200"
          href="/about"
        >
          About
        </a>
        <a
          class="block w-full rounded-md px-3 py-2 text-base font-medium bg-neutral-100 hover:bg-neutral-200 text-neutral-900 dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-neutral-100 transition-all duration-200"
          href="/test"
        >
          Test
        </a>
      </div>
    </CollapsibleContent>
  </Collapsible>
</nav>
