---
import type { HTMLAttributes } from 'astro/types';
import Layout from '../layouts/Layout.astro';

interface Props extends HTMLAttributes<'a'> {
  title: string;
}

const {
  title,
  href,
  class: className,
  target = '_blank',
  ...props
} = Astro.props;
---

<a
  class:list={['cursor-pointer m-2 p-2', className]}
  href={href}
  target={target}
>
  <div {...props}>
    {title && <h1 class="text-2xl font-bold">{title}</h1>}
    <img src="" alt="image" />
  </div>
</a>
