---
import type { HTMLAttributes } from 'astro/types';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props extends HTMLAttributes<'a'> {
  title: string;
}

const {
  title,
  href,
  class: className,
  target = '_blank',
  ...props
} = Astro.props;
---

<Card size="sm" class="mx-auto w-full max-w-sm">
  <CardHeader>
    <CardTitle>Small Card</CardTitle>
    <CardDescription>This card uses the small size variant.</CardDescription>
  </CardHeader>
  <CardContent>
    <p>
      The card component supports a size prop that can be set to "sm" for a more
      compact appearance.
    </p>
  </CardContent>
  <CardFooter>
    <Button variant="outline" size="sm" class="w-full">Action</Button>
  </CardFooter>
</Card>
