import Layout from '@/layouts/Layout.astro';
import SheetDemo from '@/components/SheetDemo.astro';
import GroupButton from '@/components/GroupButton.astro';
---

<Layout title="test" description="">
  <h1>Test Page</h1>
  <div>
    <Item
      class="max-w-3/5 mx-auto my-1 border border-secondary-accent/10"
      variant="muted"
      size="sm"
      aria-label="Item"
    >
      <ItemTitle>Authorized</ItemTitle>
      <ItemDescription>User Authorised</ItemDescription>
      <ItemContent />
    </Item>
    <SheetDemo />
    <GroupButton />
  </div>
</Layout>
